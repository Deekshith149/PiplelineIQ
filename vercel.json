{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/styles.css",
      "destination": "/src/static/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/src/static/app.js"
    },
    {
      "source": "/(.*)",
      "destination": "/src/static/index.html"
    }
  ]
}
